# Ollama Configuration
OLLAMA_HOST=Your URL
OLLAMA_MODEL=qwen3:latest

# Server Configuration
PORT=3001
NODE_ENV=development

# LLM APIs (Groq primary, Gemini fallback)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_MODEL=llama3-3-70b-8192
GEMINI_MODEL=gemini-1.5-flash

# MongoDB Atlas (replace with your connection string)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/incidentmind?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/incidentmind?retryWrites=true&w=majority

# Slack Webhook (for Communicator notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# GitHub (for Patcher PR creation)
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_OWNER=incidentmind-io
GITHUB_REPO=platform-config
GITHUB_BASE_BRANCH=main